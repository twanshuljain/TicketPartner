<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature_create_event.presentation.CreateEventBasicDetailsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_0"
        android:background="@color/orange_light_back"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/btnSaveContinue"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="@dimen/margin_15">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/size_15"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintGuide_end="@dimen/margin_15" />

            <include
                android:id="@+id/titleBar"
                layout="@layout/layout_title_name_custom" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutSteps"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:background="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleBar">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/margin_15"
                    android:layout_marginEnd="@dimen/margin_15"
                    android:layout_marginBottom="@dimen/margin_20">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_step_one"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_selected_step_one"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tvBasicDetails"
                        app:layout_constraintStart_toStartOf="@id/tvBasicDetails"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvBasicDetails"
                        style="@style/boldSecondary12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/iv_step_one"
                        android:layout_marginTop="@dimen/margin_7"
                        android:text="@string/basic_details"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_step_one" />

                    <View
                        android:layout_width="@dimen/margin_0"
                        android:layout_height="4dp"
                        android:layout_marginStart="@dimen/margin_5"
                        android:layout_marginTop="@dimen/size_8"
                        android:layout_marginEnd="@dimen/margin_5"
                        android:layout_marginBottom="@dimen/margin_5"
                        android:background="@drawable/dotted_line_create_event_purple"
                        app:layout_constraintBottom_toBottomOf="@id/iv_step_one"
                        app:layout_constraintEnd_toStartOf="@id/iv_step_second"
                        app:layout_constraintStart_toEndOf="@id/iv_step_one"
                        app:layout_constraintTop_toTopOf="@id/iv_step_one" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_step_second"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_unselect_sec_step"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tvTickets"
                        app:layout_constraintStart_toStartOf="@id/tvTickets"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTickets"
                        style="@style/boldSecondary12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_7"
                        android:text="@string/tickets"
                        app:layout_constraintEnd_toStartOf="@id/iv_step_third"
                        app:layout_constraintStart_toEndOf="@id/iv_step_one"
                        app:layout_constraintTop_toBottomOf="@id/iv_step_second" />

                    <View
                        android:layout_width="@dimen/margin_0"
                        android:layout_height="4dp"
                        android:layout_marginStart="@dimen/margin_5"
                        android:layout_marginTop="@dimen/size_8"
                        android:layout_marginEnd="@dimen/margin_5"
                        android:layout_marginBottom="@dimen/margin_5"
                        android:background="@drawable/dotted_line_create_event_grey"
                        app:layout_constraintBottom_toBottomOf="@id/iv_step_second"
                        app:layout_constraintEnd_toStartOf="@id/iv_step_third"
                        app:layout_constraintStart_toEndOf="@id/iv_step_second"
                        app:layout_constraintTop_toTopOf="@id/iv_step_second" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_step_third"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_unselect_step_third"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tvEventSetup"
                        app:layout_constraintStart_toStartOf="@id/tvEventSetup"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvEventSetup"
                        style="@style/boldSecondary12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_7"
                        android:text="@string/event_setup"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_step_one" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEventName"
                style="@style/mediumDarkPrimaryText14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/event_name"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/layoutSteps" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/startEventname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_22"
                android:src="@drawable/ic_mandatory_star"
                app:layout_constraintStart_toEndOf="@id/tvEventName"
                app:layout_constraintTop_toBottomOf="@id/layoutSteps" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEventName"
                style="@style/regularDarkPrimary14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="@dimen/size_48"
                android:layout_marginTop="@dimen/margin_5"
                android:background="@drawable/edit_text_design"
                android:hint="@string/enter_organization_name"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="@dimen/margin_10"
                android:paddingEnd="@dimen/margin_0"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/tvEventName" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEventType"
                style="@style/mediumDarkPrimaryText14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/event_type"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/etEventName" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/startEventType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_22"
                android:src="@drawable/ic_mandatory_star"
                app:layout_constraintStart_toEndOf="@id/tvEventType"
                app:layout_constraintTop_toBottomOf="@id/etEventName" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/rlSpinnerEventType"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:hint=""
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@+id/tvEventType">

                <AutoCompleteTextView
                    android:id="@+id/spinnerEvenTypes"
                    style="@style/regularDarkPrimary14"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_design"
                    android:focusableInTouchMode="false"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                style="@style/mediumDarkPrimaryText14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/description"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/rlSpinnerEventType" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/startDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_22"
                android:src="@drawable/ic_mandatory_star"
                app:layout_constraintStart_toEndOf="@id/tvDescription"
                app:layout_constraintTop_toBottomOf="@id/rlSpinnerEventType" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDescription"
                style="@style/regularDarkPrimary14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="@dimen/size_160"
                android:layout_marginTop="@dimen/margin_5"
                android:background="@drawable/edit_text_design"
                android:gravity="start"
                android:hint="@string/enter_organization_name"
                android:maxLength="140"
                android:padding="@dimen/size_8"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/tvDescription" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescLimit"
                style="@style/regularParaText12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/margin_3"
                android:paddingEnd="@dimen/margin_2"
                android:text="0 / 140"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintTop_toBottomOf="@id/etDescription" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEventCover"
                style="@style/mediumDarkPrimaryText14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/event_cover"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/tvDescLimit" />

            <RelativeLayout
                android:id="@+id/rlCover"
                android:layout_width="@dimen/margin_0"
                android:layout_height="@dimen/size_170"
                android:layout_marginTop="@dimen/size_5"
                android:background="@drawable/dotted_border_design"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/tvEventCover">

                <RelativeLayout
                    android:id="@+id/rlPickCoverImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivImageChooseCover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/ic_choose_file_cover" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvChooseFile"
                        style="@style/boldParaHeading14"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivImageChooseCover"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/margin_10"
                        android:text="@string/choose_file_upload" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvMaxCoverSizze"
                        style="@style/regularParaText12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvChooseFile"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/margin_10"
                        android:text="@string/max_size_10" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlCoverImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/edit_text_design"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCoverImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/edit_text_design"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_choose_file_cover" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivDelete"
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:layout_alignParentEnd="true"
                        android:padding="@dimen/margin_10"
                        android:src="@drawable/iv_delete_red" />

                </RelativeLayout>

            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddMoreImage"
                style="@style/mediumDarkPrimaryText14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/add_more_image"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/rlCover" />

            <RelativeLayout
                android:id="@+id/rlAddMoreImage"
                android:layout_width="@dimen/size_80"
                android:layout_height="@dimen/size_80"
                android:layout_marginTop="@dimen/size_5"
                android:background="@drawable/edit_text_design"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/tvAddMoreImage">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_plus_dark_purple" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAddMoreImages"
                android:layout_width="@dimen/margin_0"
                android:layout_height="@dimen/size_80"
                android:layout_marginTop="@dimen/size_5"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toEndOf="@id/rlAddMoreImage"
                app:layout_constraintTop_toBottomOf="@id/tvAddMoreImage"
                tools:listitem="@layout/item_image_list_create_event" />

            <View
                android:id="@+id/viewLineAddMoreImg"
                android:layout_width="@dimen/margin_0"
                android:layout_height="@dimen/margin_1"
                android:layout_marginTop="@dimen/margin_15"
                android:background="@color/placeholder"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/rlAddMoreImage" />

            <RelativeLayout
                android:id="@+id/rlMediaFromPast"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/viewLineAddMoreImg">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMediaFromPastEvent"
                    style="@style/mediumDarkPrimaryText16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/margin_10"
                    android:text="@string/media_from_past_event" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMediaFromPast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clAddImageMediaLayout"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_15"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/rlMediaFromPast">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAddImage"
                    style="@style/mediumDarkPrimaryText14"
                    android:layout_width="@dimen/margin_0"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/margin_2"
                    android:text="@string/add_images"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RelativeLayout
                    android:id="@+id/rlAddImageMediaButton"
                    android:layout_width="@dimen/size_80"
                    android:layout_height="@dimen/size_80"
                    android:layout_marginTop="@dimen/size_5"
                    android:background="@drawable/edit_text_design"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAddImage">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_plus_dark_purple" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAddImagesMedia"
                    android:layout_width="@dimen/margin_0"
                    android:layout_height="@dimen/size_80"
                    android:layout_marginTop="@dimen/size_5"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/rlAddImageMediaButton"
                    app:layout_constraintTop_toBottomOf="@id/tvAddImage"
                    tools:listitem="@layout/item_image_list_create_event" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <View
                android:id="@+id/viewLineMediaFromPast"
                android:layout_width="@dimen/margin_0"
                android:layout_height="@dimen/margin_1"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@color/placeholder"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/clAddImageMediaLayout" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDateTime"
                style="@style/semiBoldParaHeadingText18"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_15"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/date_time"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/viewLineMediaFromPast" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTimeZone"
                style="@style/mediumDarkPrimaryText14"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_15"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/timezone"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/tvDateTime" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/startTimeZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_17"
                android:src="@drawable/ic_mandatory_star"
                app:layout_constraintStart_toEndOf="@id/tvTimeZone"
                app:layout_constraintTop_toBottomOf="@id/tvDateTime" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/timeZoneLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:hint=""
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@+id/tvTimeZone">

                <AutoCompleteTextView
                    android:id="@+id/spinner_timezone"
                    style="@style/regularDarkPrimary14"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_design"
                    android:focusableInTouchMode="false"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clIncludeDateTimeLayout"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/timeZoneLayout">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineVerticalCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_end="@dimen/margin_15"
                    app:layout_constraintGuide_percent="0.5" />

                <include
                    android:id="@+id/includeDateTime"
                    layout="@layout/layout_start_end_date_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@id/guidelineVerticalCenter"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:id="@+id/rlDisplayEndTime"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_15"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/clIncludeDateTimeLayout">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDisplayEndTime"
                    style="@style/mediumDarkPrimaryText16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/media_from_past_event" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDisplayEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>

            <View
                android:id="@+id/viewDisplayEndTime"
                android:layout_width="@dimen/margin_0"
                android:layout_height="@dimen/margin_1"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@color/placeholder"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/rlDisplayEndTime" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLocation"
                style="@style/semiBoldParaHeadingText18"
                android:layout_width="@dimen/margin_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_15"
                android:drawablePadding="@dimen/margin_2"
                android:text="@string/location"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/viewDisplayEndTime" />


            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="@dimen/margin_0"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin_2"
                android:layout_marginTop="@dimen/size_5"
                android:layout_marginEnd="@dimen/margin_2"
                android:background="@drawable/curve_layout_design"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintTop_toBottomOf="@id/tvLocation"
                app:tabBackground="@drawable/selected_tab_back_color"
                app:tabGravity="fill"
                app:tabIndicator="@color/white"
                app:tabInlineLabel="true"
                app:tabSelectedTextColor="@color/paraHeading"
                app:tabTextAppearance="@style/tab_text_font"
                app:tabTextColor="@color/tab_text_color" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_20"
                android:layout_weight="1"
                android:minHeight="@dimen/size_200"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tabLayout" />


